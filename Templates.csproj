<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CataBon.DotNet.Templates</PackageId>
    <Title>El Catador/Bona DotNet Templates</Title>
    <Authors>Freddy Soto</Authors>
    <Description>Template de desarrollo para aplicaciones WEB/API.</Description>
    <PackageTags>dotnet-new;templates;elcatador;bona</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <PackageType>Template</PackageType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

<ItemGroup>
  <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**"
           Pack="true"
           PackagePath="content" />
  <Compile Remove="**\*" />
</ItemGroup>
</Project>
