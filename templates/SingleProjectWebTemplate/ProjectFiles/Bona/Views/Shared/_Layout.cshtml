        <script type="text/javascript">
            const onClickSidebar = (e) => {
                e.stopPropagation();
                e.preventDefault();


            const bodyEl = getElementInstance('app');
            const isOpen = bodyEl.classList.contains('sidenav-toggled');
            // // Custom behavior when sidebar is closed
            if (isOpen) {
                bodyEl.classList.remove('sidenav-toggled');
                $('#menu_logo_open').css({
                    'display': 'flex'
                });
                $('#menu_logo_closed').css({
                    'display': 'none'
                });
                $('.app-sidebar__user>div').css({
                    'align-items': 'normal',
                })
                // your custom behavior here
            } else {
                bodyEl.classList.add('sidenav-toggled');
                $('#menu_logo_open').css({
                    'display': 'none'
                });
                $('#menu_logo_closed').css({
                    'display': 'flex'
                });
                $('.app-sidebar__user>div').css({
                    'align-items': 'center'
                })
                
                // optional behavior when open
            }
        }
        

            const showLoader = (theme = 'custom', spinnerColor = 'F29D35', message = 'Cargando datos. Por favor, espere.', backgroundColor = '#344055', textColor = 'white') => {
                //THEMES
                /**
                 *  sk-rect
                 *  sk-bounce
                 *  sk-folding-cube
                 *  sk-circle
                 *  sk-dot
                 *  sk-bounce
                 *  sk-falding-circle
                 *  sk-cube-grid
                 *  custom
                 *  **/
                const loaderElement = document.getElementById('holdon-overlay');
                if (!loaderElement) {
                    HoldOn.open({
                        theme: theme,
                        // custom content here
                        content: `<div class="spinner-border text-dark" style="color:#${spinnerColor}!important" role="status">
                                                                        <span class="visually-hidden">Loading...</span>
                                                                    </div>`,
                        // loading message here
                        message: message,
                        // background color
                        backgroundColor: backgroundColor,
                        // text color
                        textColor: textColor,
                    });
                }
            }

            const hideLoader = () => HoldOn.close();

            Dropzone.autoDiscover = false;
            
    initializeScrollToTopFloatingButtons();
            const validateBreadCrumbPaginatorOption = (breadcrumbId) => {
                let hasNextTab = FSBootstrapTab.hasNextTab('nav-breadcrumb');
                let hasPrevTab = FSBootstrapTab.hasPreviousTab('nav-breadcrumb');
                if (!hasNextTab) {
                    $('#paginate-next').addClass('disabled')
                    $('button', '#paginate-next').removeClass('black-text').addClass('grey-text');
                }
                else {
                    $('#paginate-next').removeClass('disabled');
                    $('button', '#paginate-next').addClass('black-text').removeClass('grey-text');
                }

                if (!hasPrevTab) {
                    $('#paginate-previous').addClass('disabled')
                    $('button', '#paginate-previous').removeClass('black-text').addClass('grey-text');
                }
                else {
                    $('#paginate-previous').removeClass('disabled');
                    $('button', '#paginate-previous').addClass('black-text').removeClass('grey-text');
                }
            }
            validateBreadCrumbPaginatorOption()
            FSBootstrapTab.onHidden('nav-breadcrumb', validateBreadCrumbPaginatorOption)
            const nextPane = (event) => {
                FSBootstrapTab.showNextTab('nav-breadcrumb', false);
                validateBreadCrumbPaginatorOption()
            }
            const previousPane = (event) => {
                FSBootstrapTab.showPreviousTab('nav-breadcrumb');
                validatePaginatorOption()
            }

        

        </script>

