    <script>

    
        const onClickSidebar = (e) => {
       e.stopPropagation();
       e.preventDefault();


       const bodyEl = getElementInstance('app');
       const isOpen = bodyEl.classList.contains('sidenav-toggled');
       // // Custom behavior when sidebar is closed
       if (isOpen) {
           bodyEl.classList.remove('sidenav-toggled');
           $('#menu_logo_open').css({
               'display': 'flex'
           });
           $('#menu_logo_closed').css({
               'display': 'none'
           });
           $('.app-sidebar__user>div').css({
               'align-items': 'normal',
           })
           // your custom behavior here
       } else {
           bodyEl.classList.add('sidenav-toggled');
           $('#menu_logo_open').css({
               'display': 'none'
           });
           $('#menu_logo_closed').css({
               'display': 'flex'
           });
           $('.app-sidebar__user>div').css({
               'align-items': 'center'
           })
         
           // optional behavior when open
       }
   }
        const showLoader = (theme = 'custom', spinnerColor = 'F29D35', message = 'Cargando datos, por favor espere', backgroundColor = '#344055', textColor = 'white') => {
            //THEMES
            /**
             *  sk-rect
             *  sk-bounce
             *  sk-folding-cube
             *  sk-circle
             *  sk-dot
             *  sk-bounce
             *  sk-falding-circle
             *  sk-cube-grid
             *  custom
             *  **/
            const loaderElement = document.getElementById('holdon-overlay');
            if (!loaderElement) {
                HoldOn.open({
                    theme: theme,
                    // custom content here
                    content: `<div class="spinner-border text-dark" style="color:#${spinnerColor}!important" role="status">
                                                                                                                                                                                                                                                                                <span class="visually-hidden"></span>
                                                                                                                                                                                                                                                                            </div>`,
                    // loading message here
                    message: message,
                    // background color
                    backgroundColor: backgroundColor,
                    // text color
                    textColor: textColor,
                });
            }
        }
     

        $(document).ready(() => {
            $('#sBuscarSist').bind('keyup', function () {
                var searchString = $(this).val();
                // Search text
                var text = $(this).val().toLowerCase();
                // Hide all content class element
                $('.contentS').hide();
                // Search
                $('.contentS .titleS').each(function () {
                    if ($(this).text().toLowerCase().indexOf("" + text + "") != -1) {
                        $(this).closest('.contentS').show();
                    }
                });
            });
        })


        $("#dvLink").on('click', '.clGetUtl', function (e) {
            e.preventDefault();
            var url = $(this).data('url');
            var id = $(this).data('id');
            var sistema = $(this).data('sistema');
            showLoader('sk-bounce', "", "Accediendo al Sistema " + sistema + " ,Espere por favor...");

            setTimeout(function () {
                window.location.href = url + "?id=" + id;
                hideLoader();
            }, 2000);
        });

        const hideLoader = () => HoldOn.close();

        function loadModal(elm, texto, icon, ocultar) {
            $(elm + ' #bTitulo').text(texto);
            $(elm + ' #lbIcon').html(icon);

            console.log(elm);
            console.log($(elm + ' #bTitulo'));

            if (ocultar == true) {
                $(elm).modal("hide");
            } else {

                $(elm).modal({
                    backdrop: 'static',
                    keyboard: false
                });

                $(".modal-header").on("mousedown", function (mousedownEvt) {
                    var $draggable = $(this);
                    var x = mousedownEvt.pageX - $draggable.offset().left,
                        y = mousedownEvt.pageY - $draggable.offset().top;
                    $("body").on("mousemove.draggable", function (mousemoveEvt) {
                        $draggable.closest(".modal-dialog").offset({
                            "left": mousemoveEvt.pageX - x,
                            "top": mousemoveEvt.pageY - y
                        });
                    });
                    $("body").one("mouseup", function () {
                        $("body").off("mousemove.draggable");
                    });
                    $draggable.closest(".modal").one("bs.modal.hide", function () {
                        $("body").off("mousemove.draggable");
                    });
                });
            }
        }

        $(".select2").select2({
            theme: "bootstrap"
            //allowClear: true,
            //width: '100%'
        });

        $('.summernote2').summernote({
            height: 220,
