{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{AzureTenant}",
    "ClientId": "{AzureAdClientId}",
    "CallbackPath": "/signin-oidc",
    "Domain": "{CompanyDomain}",
    "RedirectUri": "https://localhost:44324/signin-oidc",
    "ClientSecret": "{AzureAdClientSecret}",
    "ValidIssuer": "https://sts.windows.net/{AzureTenant}/",
    "Scopes": ""
  },
  "DownstreamApis": {
    "ExampleApi": {
      "BaseUrl": "https://localhost",
      "Scopes": {
        "ReadWrite": "scope_url",
        "Read": "scope_url"
      }
    },
    "MicrosoftGraph": {
      // Specify BaseUrl if you want to use Microsoft graph in a national cloud.
      // See https://learn.microsoft.com/graph/deployments#microsoft-graph-and-graph-explorer-service-root-endpoints
      "BaseUrl": "https://graph.microsoft.com/v1.0",
      // Set RequestAppToken this to "true" if you want to request an application token (to call graph on 
      // behalf of the application). The scopes will then automatically
      // be ['https://graph.microsoft.com/.default'].
      "RequestAppToken": true
    }
  },
  "AppInfo": {
    "SystemId": "{SystemId}",
    "CompanyKey": "{CompanyKey}",
    "CompanyDomain": "", // Solo utilizar en servidor de produccion. Verifcia que la url sea dominio.com si no, se queda en un loop autenticando
    "SystemCode": "{SystemCode}",
    "SystemKey": "{SystemKey}",
    "SystemTitle": "{SystemTitle}",
    "Mode": "Development",
    "SingleSignOut": false,
    "CookieExpirationHours": 8,
    "DistributedCache": {
      "SlidingExpirationHours": 2
    }
  },
  "MiddlewareSettings": {
    "UsePaginationResponseWrapperMiddleware": false,
    "EncryptionHashKey": "{EncryptionHashKey}"
  },
  "FileServers": [
    {
      "EnableDirectoryBrowsing": true,
      "Name": "SSRS",
      "Path": "temp/reports",
      "RequestPath": "/reports",
      "ServerAddress": "C:",
      "IsLocalPath": true
    }
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server={DbServerAddress};Database={DbName};user id={DbUserId}; password={DbUserPassword};MultipleActiveResultSets=true;TrustServerCertificate=True",
    "NLogConnection": "Data Source={DbServerAddress};Initial Catalog=ADM;User Id={DbUserId};password={DbUserPassword};MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AdmConnection": "Data Source={DbServerAddress};Initial Catalog=ADM;User Id={DbUserId};password={DbUserPassword};MultipleActiveResultSets=true;TrustServerCertificate=True",
    "MailDbConnection": "Data Source={DbServerAddress};Initial Catalog=ADM;User Id={DbUserId};password={DbUserPassword};MultipleActiveResultSets=true;TrustServerCertificate=True",
    "ReportingServicesDbConnection": "Data Source={DbServerAddress};Initial Catalog=ADM;User Id={DbUserId};password={DbUserPassword};MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}