{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{AzureTenant}",
    "ClientId": "{AzureAdClientId}",
    "CallbackPath": "/signin-oidc",
    "Domain": "{CompanyDomain}",
    "RedirectUri": "https://localhost:44324/signin-oidc",
    "ClientSecret": "",
    "ValidIssuer": "https://sts.windows.net/{AzureTenant}/",
    "Scopes": ""
  },
  "DownstreamApis": {
    "ExampleApi": {
      "BaseUrl": "https://localhost",
      "Scopes": {
        "ReadWrite": "scope_url",
        "Read": "scope_url"
      }
    },
    "MicrosoftGraph": {
      // Specify BaseUrl if you want to use Microsoft graph in a national cloud.
      // See https://learn.microsoft.com/graph/deployments#microsoft-graph-and-graph-explorer-service-root-endpoints
      "BaseUrl": "https://graph.microsoft.com/v1.0",
      // Set RequestAppToken this to "true" if you want to request an application token (to call graph on 
      // behalf of the application). The scopes will then automatically
      // be ['https://graph.microsoft.com/.default'].
      "RequestAppToken": true
    }
  },
  "AppInfo": {
    "SystemId": "{SystemId}",
    "CompanyKey": "{CompanyKey}",
    "SystemCode": "{SystemCode}",
    "SystemKey": "{SystemKey}",
    "SystemTitle": "{SystemTitle}",
    "Mode": "Staging"
  },
  "AllowedOrigins": {
    "{CompanyKey}_APPS": "https://*.{CompanyDomain}"
  },
  "MiddlewareSettings": {
    "UsePaginationResponseWrapperMiddleware": true,
    "EncryptionHashKey": "Prueba"
  },
  "FileServers": [
    {
      "EnableDirectoryBrowsing": true,
      "Name": "SSRS",
      "Path": "temp/reports",
      "RequestPath": "/reports",
      "ServerAddress": "C:",
      "IsLocalPath": true
    }
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=CATSRVDEV01;Database={DbName};user id=Aplicaciones; password=AppPass2013;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "NLogConnection": "Data Source=CATSRVDEV01;Initial Catalog=ADM;User Id=Aplicaciones;password=AppPass2013;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AdmConnection": "Data Source=CATSRVDEV01;Initial Catalog=ADM;User Id=Aplicaciones;password=AppPass2013;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "MailDbConnection": "Data Source=CATSRVDEV01;Initial Catalog=ADM;User Id=Aplicaciones;password=AppPass2013;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "ReportingServicesDbConnection": "Data Source=CATSRVDEV01;Initial Catalog=ADM;User Id=Aplicaciones;password=AppPass2013;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
