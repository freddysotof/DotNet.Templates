{
  "$schema": "http://json.schemastore.org/template",
  "author": "Freddy Soto",
  "classifications": [
    "Web",
    "REST",
    "API",
    "Onion",
    "Clean"
  ],
  "identity": "HybridOnionCleanApiTemplate",
  "name": "Hybrid Onion/Clean Api Template",
  "description": "Template web api dividido en capas con arquitectura Onion/Clean",
  "shortName": "hybridonioncleanapitemplate",
  "sourceName": "HybridOnionCleanApiTemplate",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework of the project",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0"
        }
      ],
      "defaultValue": "net8.0",
      "replaces": "{TargetFramework}"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "random",
      "parameters": {
        "low": 5000,
        "high": 5999
      },
      "replaces": "5075",
      "readOnly": true
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "random",
      "parameters": {
        "low": 7000,
        "high": 7999
      },
      "replaces": "7075",
      "readOnly": true
    },
    "SslPort": {
      "type": "generated",
      "generator": "random",
      "parameters": {
        "low": 44300,
        "high": 44399
      },
      "replaces": "44324",
      "readOnly": true
    },
    "Company": {
      "type": "parameter",
      "description": "The company who owns this project",
      "datatype": "choice",
      "choices": [
        {
          "choice": "Catador"
        },
        {
          "choice": "Bona"
        }
      ],
      "defaultValue": "",
      "replaces": "{CompanyKey}",
      "isRequired": true
    },
    "CompanyDomain": {
      "type": "parameter",
      "displayName": "Company Domain",
      "description": "The company domain who owns this project",
      "datatype": "choice",
      "choices": [
        {
          "choice": "elcatador.com"
        },
        {
          "choice": "bona.com.do"
        }
      ],
      "defaultValue": "",
      "replaces": "{CompanyDomain}",
      "isRequired": true
    },
    "SystemKey": {
      "type": "parameter",
      "displayName": "System Key",
      "description": "The System Key of the project",
      "datatype": "text",
      "replaces": "{SystemKey}",
      "isRequired": true
    },
    "SystemId": {
      "type": "parameter",
      "displayName": "System Id",
      "description": "The System Id of the project",
      "datatype": "int",
      "replaces": "{SystemId}",
      "defaultValue": "1"
    },
    "SystemCode": {
      "type": "parameter",
      "displayName": "System Code",
      "description": "The System Code of the project",
      "datatype": "int",
      "replaces": "{SystemCode}",
      "defaultValue": "1"
    },
    "SystemTitle": {
      "type": "parameter",
      "displayName": "System Title",
      "description": "The System Title of the project",
      "datatype": "text",
      "replaces": "{SystemTitle}"
    },
    "AzureAdTenant": {
      "type": "parameter",
      "displayName": "Azure AD Tenant",
      "description": "The Azure Tenant for single sign-in on Azure",
      "datatype": "text",
      "replaces": "{AzureTenant}",
      "isRequired": false
    },
    "AzureAdClientId": {
      "type": "parameter",
      "displayName": "Azure AD ClientId",
      "description": "The Client ID for single sign-in on Azure Tenant",
      "datatype": "text",
      "replaces": "{AzureAdClientId}",
      "isRequired": false
    },
    "AzureAdClientSecret": {
      "type": "parameter",
      "displayName": "Azure AD Client Secret",
      "description": "The Client Secret for single sign-in on Azure Tenant",
      "datatype": "text",
      "replaces": "{AzureAdClientSecret}",
      "isRequired": false
    },
    "DbName": {
      "type": "parameter",
      "displayName": "Database Name",
      "description": "The Database Name",
      "datatype": "text",
      "replaces": "{DbName}"
    },
    "EnableMicrosoftGraph": {
      "type": "parameter",
      "displayName": "Enable Microsoft Graph Service API",
      "description": "Enable Microsoft Graph Service API",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EnableHttpClientApi": {
      "type": "parameter",
      "displayName": "Enable HTTP Client for external API with optional hashing validator",
      "description": "Enable HTTP Client for external API with optional hashing validator",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EnableLogger": {
      "type": "parameter",
      "displayName": "Enable Logger Service",
      "description": "Enables Logger Service",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EnableGlobalErrorHandler": {
      "displayName": "Enable Global Error Handler",
      "type": "parameter",
      "description": "Enables Global Error Handler Middleware",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EnableRequestResponseLogger": {
      "type": "parameter",
      "displayName": "Enable Request and Response Logger Middleware",
      "description": "Captures and log any request or response made to the app",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EnableHashEncryptionValidation": {
      "type": "parameter",
      "displayName": "Enable Hash Encryption Validation",
      "description": "Enable Hash Encryption Validation to make or receive HTTP Request",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EnableResponseWrapper": {
      "type": "parameter",
      "displayName": "Enable Response Wrapper Middleware",
      "description": "Enables Response Wrapper in Responses (Custom Response on Return Responses)",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EnableRoutingLowerCase": {
      "type": "parameter",
      "displayName": "Enable Routing with lowercase urls",
      "description": "Enables routing with lowercase urls",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EnableAutoMapper": {
      "type": "parameter",
      "description": "Enables AutoMapper Config",
      "displayName": "Enable AutoMapper",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EnableFileServer": {
      "type": "parameter",
      "displayName": "Enables Virtual File Server",
      "description": "Enables File Server Virtual Directory Configuration",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "IncludeDevAppSettings": {
      "type": "parameter",
      "displayName": "Configure Development Mode",
      "description": "Add appsettings.Development",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "IncludeStagingAppSettings": {
      "type": "parameter",
      "displayName": "Configure Staging Mode",
      "description": "Add appsettings.Staging and Web.Staging",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "IsCatador": {
      "type": "computed",
      "value": "(Company == \"Catador\")"
    },
    "IsBona": {
      "type": "computed",
      "value": "(Company == \"Bona\")"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        ".git/**/*",
        "ProjectFiles/**" // ← prevent both .csproj files from being copied
      ],
      "modifiers": [
        {
          "condition": "(!IncludeDevAppSettings)",
          "exclude": [
            "HybridOnionCleanApiTemplate.Api/appsettings.Development.json"
          ]
        },
        {
          "condition": "(!IncludeStagingAppSettings)",
          "exclude": [
            "HybridOnionCleanApiTemplate.Api/appsettings.Staging.json",
            "HybridOnionCleanApiTemplate.Api/Web.Staging.config"
          ]
        },
        {
          "condition": "(!EnableAutoMapper)",
          "exclude": [
            "**/Mappings/**"
          ]
        }
      ]
    },
    {
      "source": "ProjectFiles/Catador",
      "target": "HybridOnionCleanApiTemplate.Api",
      "condition": "(Company == 'Catador')",
      "modifiers": [
        {
          "include": [
            "appsettings.Development.json",
            "appsettings.Staging.json"
          ]
        }
      ]
    },
    {
      "source": "ProjectFiles/Bona",
      "target": "HybridOnionCleanApiTemplate.Api",
      "condition": "(Company == 'Bona')",
      "modifiers": [
        {
          "include": [
            "appsettings.Development.json",
            "appsettings.Staging.json"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "HybridOnionCleanApiTemplate.Api.csproj"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\")",
      "path": "README.md"
    }
  ]
}